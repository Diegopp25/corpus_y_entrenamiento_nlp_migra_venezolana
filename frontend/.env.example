# Copia este archivo a `.env.local` (o `.env`) para que Vite lo cargue.
# El frontend lee estas variables con import.meta.env.* en src/services/api.ts.

# URL base del API FastAPI de cobertura mediática.
VITE_API_URL=http://127.0.0.1:8000

# Solo si el API arranca con NLP_API_KEY definida (header X-API-Key).
# ¡Ojo! Las variables VITE_* quedan visibles en el bundle: úsalo solo en demo local.
# VITE_API_KEY=

# Timeout opcional por petición, en milisegundos (por defecto 30000).
# VITE_API_TIMEOUT_MS=45000
