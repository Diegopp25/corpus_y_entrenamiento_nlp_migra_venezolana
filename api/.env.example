# ============================================================================
# API de cobertura mediática de la migración venezolana — ejemplo de .env
# ----------------------------------------------------------------------------
# IMPORTANTE: si ya tienes api/.env configurado (por ejemplo con las rutas de
# los pesos BETO), NO lo sobreescribas con este archivo: solo cópialo la
# primera vez. Si lo copias encima, vuelve a poner NLP_SENTIMENT_MODEL_DIR y
# NLP_FRAMES_MODEL_DIR o el API arrancará con el motor léxico (degradado).
#
#   Copy-Item .env.example .env     # solo la primera vez
#
# Todas las variables usan el prefijo NLP_ (pydantic-settings). También se
# pueden definir como variables de entorno del sistema; el archivo .env tiene
# menor prioridad que el entorno real. Las rutas relativas se resuelven contra
# la carpeta `api/`.
# ============================================================================

# ----------------------------- Aplicación ----------------------------------
NLP_ENVIRONMENT=dev
NLP_LOG_LEVEL=INFO
# Desactiva /docs, /redoc y /openapi.json en producción si no los quieres expuestos
NLP_DOCS_ENABLED=true

# ------------------------------ Seguridad ----------------------------------
# Si se define NLP_API_KEY, todos los endpoints salvo /, /v1/health, /metrics y
# la documentación (/docs, /redoc, /openapi.json) exigen el header
# `X-API-Key: <clave>` (o `Authorization: Bearer <clave>`).
# Déjalo comentado en desarrollo para no exigir autenticación.
# NLP_API_KEY=cambia-esta-clave-larga-y-aleatoria

# Orígenes permitidos por CORS. IMPORTANTE: pydantic-settings exige JSON válido
# para las variables de tipo lista (no vale `*` ni una lista separada por comas).
#   Todos:                     NLP_CORS_ORIGINS=["*"]
#   Front de Vite en local:    NLP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
NLP_CORS_ORIGINS=["*"]

# Rate limit por cliente (IP, o prefijo de API key si se envía)
NLP_RATE_LIMIT_REQUESTS=120
NLP_RATE_LIMIT_WINDOW_SECONDS=60

# Límites del contrato de análisis
NLP_MAX_TEXT_CHARS=20000
NLP_MAX_BATCH_ITEMS=50
# Guarda eventos de acceso en SQLite (tabla api_events) para /v1/monitoring/stats
NLP_STORE_EVENTS=true

# -------------------------------- Modelos ----------------------------------
# Motor: auto | bert_pair | multitask | lexicon
#   auto      -> intenta BETO par (2 modelos) y si no, BETO multitarea y si no, léxico
#   bert_pair -> exige NLP_SENTIMENT_MODEL_DIR y NLP_FRAMES_MODEL_DIR
#   multitask -> exige NLP_MULTITASK_MODEL_DIR (model.pt + sentiment_classes.json)
#   lexicon   -> baseline léxico (no requiere torch)
NLP_ENGINE=auto

# Pesos BETO entrenados. NO se versionan en el repo (pesan cientos de MB).
# Rutas a las carpetas guardadas con `save_pretrained` de Hugging Face.
# En Windows usa rutas absolutas con doble barra invertida o barras normales.
# NLP_SENTIMENT_MODEL_DIR=C:/ruta/a/modelo_sentimiento
# NLP_FRAMES_MODEL_DIR=C:/ruta/a/modelo_encuadre
# NLP_MULTITASK_MODEL_DIR=C:/ruta/a/models_beto/multitask_beto

# Dispositivo de inferencia: auto | cpu | cuda | cuda:0 (auto detecta GPU)
NLP_DEVICE=auto
# Longitud máxima de tokens que se pasan a BETO
NLP_MAX_LENGTH=512
# Umbral por defecto para marcar un encuadre como activo (0..1)
NLP_FRAME_THRESHOLD=0.5
# Umbrales por encuadre generados por scripts/evaluate_models.py
# NLP_THRESHOLDS_PATH=artifacts/thresholds.json
# Métricas reales de evaluación que sirve /v1/dashboard/models
# NLP_EVALUATION_PATH=artifacts/evaluation.json
# Léxico de respaldo (sentimiento + encuadres + términos de sesgo)
# NLP_LEXICON_PATH=app/resources/lexicon.json
# Precarga spaCy en el motor multitarea (es_core_news_lg)
NLP_PREPROCESS_WITH_SPACY=true

# ----------------------------- Persistencia ---------------------------------
# Base SQLite donde se guardan análisis, jobs y eventos (WAL).
# En Docker se sobrescribe a /app/data/api.db.
NLP_DATABASE_PATH=data/api.db
# Carpeta de artefactos (thresholds.json, evaluation.json)
NLP_ARTIFACTS_DIR=artifacts
# CSV etiquetado del corpus que alimenta /v1/dashboard/corpus
NLP_CORPUS_CSV_PATH=../Data/dataset_migracion_venezolana_labeled.csv

# -------------------------------- Scraper -----------------------------------
NLP_SCRAPER_ENABLED=true
# Respetar robots.txt de los sitios (recomendado; desactivar solo en pruebas)
NLP_SCRAPER_RESPECT_ROBOTS=true
NLP_SCRAPER_USER_AGENT=MigraVenezuelaBot/1.0 (+https://github.com/Diegopp25/corpus_y_entrenamiento_nlp_migra_venezolana)
NLP_SCRAPER_TIMEOUT_SECONDS=20
NLP_SCRAPER_MAX_ARTICLES=8
# Tope de bytes descargados por respuesta (protección contra respuestas gigantes)
NLP_SCRAPER_MAX_RESPONSE_BYTES=5000000
# Bloquea peticiones a redes privadas/loopback (protección SSRF). En local puede
# hacer falta ponerlo en true solo si escaneas un servidor de pruebas propio.
NLP_SCRAPER_ALLOW_PRIVATE_NETWORKS=false
# Palabras clave para filtrar noticias. Como es una lista, pydantic-settings
# exige JSON válido entre corchetes y comillas dobles:
# NLP_SCRAPER_KEYWORDS=["migración","venezolanos","venezolana","frontera","refugiados"]
NLP_SCRAPER_MAX_JOBS_IN_PARALLEL=2
# Los jobs y eventos se limpian al arrancar; TTL de jobs en horas
NLP_SCRAPER_JOB_TTL_HOURS=24
